# Every text file is stored and checked out with LF, so a Windows checkout
# holds the same bytes as a Linux one (CLAUDE.md §4).
* text=auto eol=lf

# Binary formats: never convert.
*.png binary
*.jpg binary
*.pdf binary
*.pbf binary
*.gpkg binary
*.zip binary

# The built pilot's goldens hold real-source idioms (CRLF lines, byte-order marks, shapefiles,
# spreadsheets): stored byte for byte.
tests/golden/pilot_build/** binary
tests/golden/pilot_build/SHA256SUMS text eol=lf
